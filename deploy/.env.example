# Copy to .env and fill in. .env is gitignored — never commit the real token.
#
# Get this from: Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels
#   -> your tunnel -> Configure -> the token in the install command.
# It is a long base64 string. Treat it as a password: anyone holding it can
# publish traffic through your tunnel.

TUNNEL_TOKEN=paste-your-cloudflare-tunnel-token-here
