# Copy to .env and fill in. .env is gitignored — never commit the real values.

# ---------------------------------------------------------------------------
# Cloudflare tunnel
# ---------------------------------------------------------------------------
# Get this from: Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels
#   -> your tunnel -> Configure -> the token in the install command.
# It is a long base64 string. Treat it as a password: anyone holding it can
# publish traffic through your tunnel.

TUNNEL_TOKEN=paste-your-cloudflare-tunnel-token-here

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# POSTGRES_PASSWORD is what the postgres container is created with, and it has
# to match the password inside DATABASE_URL — they are the same credential
# written twice. Compose refuses to start without POSTGRES_PASSWORD set.
#
# Generate one with:  openssl rand -base64 24
#
# The container publishes no port: it is reachable only from other services on
# the compose network, by the hostname `postgres`. For local development
# against a Postgres running on your own machine, use `localhost` instead:
#   DATABASE_URL=postgresql+psycopg://promptworks:promptworks@localhost:5432/promptworks

POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg://promptworks:changeme@postgres:5432/promptworks

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# JWT_SECRET signs session tokens. Anyone who knows it can mint a token for
# any account, so treat it as a root credential. Use at least 32 bytes:
#   openssl rand -base64 48
#
# JWT_EXPIRY_MINUTES defaults to 7 days. Tokens are stateless — there is no
# revocation — so this value is the blast radius of a leaked token.

JWT_SECRET=generate-a-long-random-value
JWT_EXPIRY_MINUTES=10080
LOGIN_CODE_EXPIRY_MINUTES=10

# Applied per IP *and* per email address on /auth/request-code.
LOGIN_CODE_RATE_LIMIT=3/minute

# Local development only: with no RESEND_API_KEY set, LOGIN_CODE_DEV_ECHO=1
# logs the login code to the server console instead of emailing it. This
# writes a live credential to your logs — never set it anywhere real.
# LOGIN_CODE_DEV_ECHO=1

# ---------------------------------------------------------------------------
# Email delivery (Resend)
# ---------------------------------------------------------------------------
# RESEND_FROM_EMAIL must be an address on a domain you have verified with
# Resend, or sends will be rejected.

RESEND_API_KEY=
RESEND_FROM_EMAIL=login@yourdomain.com

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Defaults to the
# Vite dev server when unset. Set your real frontend origin before shipping —
# a wildcard here lets any site on the internet spend Anthropic credit through
# a visitor's browser.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bearer token for GET /admin/spend. Unset means the endpoint is disabled
# (503) rather than open to anyone who finds the URL.
ADMIN_TOKEN=

# Refuse new grading requests once the day's spend reaches this many dollars.
# Unset means no cap.
# PROMPTWORKS_DAILY_BUDGET_USD=5.00

# Per-IP limit on POST /attempts, the only endpoint that costs money per call.
ATTEMPTS_RATE_LIMIT=10/minute

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
# Backend only. Never expose this to the frontend — server-side grading is the
# entire point of Stage 2.
ANTHROPIC_API_KEY=
